# 設計師 AI 助理：環境變數範本。
#
# ⚠ 這份檔案只寫「欄位名」，不寫值。複製成 .env 再把值填進去；
#    .env 不進版控（.gitignore 已擋）。
#
# 完全不填也能跑：預設的 REPLAY_MODE=1 走錄好的逐字稿，
# 一把金鑰都不需要就能重現一整輪對話（見 README「三種跑法」）。

# --- 要不要打真的模型 --------------------------------------------------------

# 1 = 走錄好的逐字稿（零金鑰，預設）。0 = 打下面設定的模型端點。
REPLAY_MODE=1

# 1 = 用套件內固定 seed 的示範資料（MockSalonDataProvider）。這是公開版唯一的資料來源。
DEMO_MODE=1

# --- 模型端點（任何 OpenAI 相容的服務都可以）--------------------------------
#
# 欄位名沿用 QWEN_ 前綴只是歷史因素，填別家的位址一樣會動——
# 程式只認「OpenAI 相容的 /chat/completions」這件事，沒有寫死任何廠商。
# 我們實際量過哪幾個模型、分數如何，見 README 的「模型對決」。

# 你的金鑰。留空就不要把 REPLAY_MODE 關掉。
QWEN_API_KEY=

# OpenAI 相容端點的 base URL，結尾通常是 /v1。
QWEN_BASE_URL=

# 模型名稱。留空就用 assistant/config/defaults.yaml 裡的 model_default。
QWEN_MODEL=

# --- 選填 --------------------------------------------------------------------

# 覆蓋預設設定的檔案路徑。不填就用 assistant/config/defaults.yaml，
# 也可以在同目錄放 local.yaml（已 .gitignore）只改要改的那幾格。
ASSISTANT_CONFIG_PATH=
